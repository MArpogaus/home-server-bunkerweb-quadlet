# Bunkerweb Service Configuration
# Copy to .env and fill in secrets

# Server name
SERVER_NAME=cloud.example.com

# TLS / Let's Encrypt
AUTO_LETS_ENCRYPT=yes
USE_LETS_ENCRYPT=yes

# Rate limiting
LIMIT_REQ_RATE=3r/s

# Geo-restriction
# WHITELIST_COUNTRY=DE CH AT

# Bunkerweb API
API_WHITELIST_IP=127.0.0.1 10.0.0.0/8
