# Bunkerweb Configuration
# Copy to bunkerized_nginx.env and customize

# Server
SERVER_NAME=cloud.your-domain.de
WHITELIST_COUNTRY=DE CH AT

# Security
USE_BUNKERNET=no
USE_MODSECURITY=no
LIMIT_REQ_RATE=3r/s
AUTO_LETS_ENCRYPT=yes
DISABLE_DEFAULT_SERVER=yes

# Features
MULTISITE=yes
SERVE_FILES=no
USE_CLIENT_CACHE=yes
USE_GZIP=yes
USE_REVERSE_PROXY=yes

# Reverse Proxy (Nextcloud)
cloud.your-domain.de_REVERSE_PROXY_HOST=http://nextcloud-web:80
cloud.your-domain.de_REVERSE_PROXY_WS=yes
cloud.your-domain.de_MAX_CLIENT_SIZE=10G
cloud.your-domain.de_USE_CLIENT_CACHE=yes
cloud.your-domain.de_ALLOWED_METHODS=GET|POST|HEAD|COPY|DELETE|LOCK|MKCOL|MOVE|PROPFIND|PROPPATCH|PUT|UNLOCK|OPTIONS|REPORT|SEARCH
cloud.your-domain.de_X_FRAME_OPTIONS=SAMEORIGIN

# JSON Analytics
cloud.your-domain.de_USE_LOGFORMAT=yes
cloud.your-domain.de_LOGFORMAT=${JSON_ANALYTICS_LOGFORMAT}
