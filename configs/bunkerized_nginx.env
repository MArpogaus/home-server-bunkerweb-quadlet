SERVER_NAME=cloud.arpogaus.de
WHITELIST_COUNTRY=DE CH AT
USE_BUNKERNET=no
USE_MODSECURITY=no
LIMIT_REQ_RATE=3r/s
AUTO_LETS_ENCRYPT=yes
DISABLE_DEFAULT_SERVER=yes
MULTISITE=yes
SERVE_FILES=no
USE_CLIENT_CACHE=yes
USE_GZIP=yes
USE_REVERSE_PROXY=yes
REVERSE_PROXY_URL=/

cloud.arpogaus.de_REVERSE_PROXY_HOST=http://nextcloud-web:80
cloud.arpogaus.de_REVERSE_PROXY_WS=yes
cloud.arpogaus.de_MAX_CLIENT_SIZE=10G
cloud.arpogaus.de_USE_CLIENT_CACHE=yes
cloud.arpogaus.de_ALLOWED_METHODS=GET|POST|HEAD|COPY|DELETE|LOCK|MKCOL|MOVE|PROPFIND|PROPPATCH|PUT|UNLOCK|OPTIONS|REPORT|SEARCH
cloud.arpogaus.de_X_FRAME_OPTIONS=SAMEORIGIN
cloud.arpogaus.de_BAD_BEHAVIOR_STATUS_CODES=400 401 403 405 444
cloud.arpogaus.de_LIMIT_REQ_URL_1=/apps
cloud.arpogaus.de_LIMIT_REQ_RATE_1=5r/s
cloud.arpogaus.de_LIMIT_REQ_URL_2=/apps/text/session/sync
cloud.arpogaus.de_LIMIT_REQ_RATE_2=8r/s
cloud.arpogaus.de_LIMIT_REQ_URL_3=/core/preview
cloud.arpogaus.de_LIMIT_REQ_RATE_3=5r/s
cloud.arpogaus.de_LIMIT_REQ_URL_4=/remote.php/
cloud.arpogaus.de_LIMIT_REQ_RATE_4=8r/s
cloud.arpogaus.de_LIMIT_REQ_URL_5=/push/ws
cloud.arpogaus.de_LIMIT_REQ_RATE_5=8r/s
cloud.arpogaus.de_LIMIT_REQ_URL_6=/apps/memories/api/
cloud.arpogaus.de_LIMIT_REQ_RATE_6=8r/s
